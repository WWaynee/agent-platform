# =============================================
# 环境变量模板（含示例值/占位符）
# 用法：cp .env.example .env 后填入真实值
# 注意：.env 已被 .gitignore 排除，不会提交到仓库，请勿提交真实密钥。
# =============================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PWD=your_mysql_password
MYSQL_DB=agent_platform

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret
MINIO_BUCKET=document-store
MINIO_USE_SSL=false

# ---------- Qdrant ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-secret
JWT_EXPIRE_SECONDS=86400

# ---------- LLM（对话） ----------
# 对话使用 DeepSeek（OpenAI 兼容接口）
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRY=3

# ---------- LLM Embedding（可选，独立向量服务） ----------
# 若配置则向量走独立的厂商（如硅基流动）；留空则自动回退用上面的 LLM_API_KEY/LLM_BASE_URL（单厂商全包）。
# 注意：不同厂商 baseURL 是否带 /v1 前缀不同，请按厂商填写（如硅基流动需带 /v1）。
# DeepSeek baseURL 不带 /v1，硅基流动需带 /v1。
LLM_EMBED_API_KEY=your_siliconflow_api_key
LLM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

# ---------- Server ----------
SERVER_HTTP_PORT=8080
