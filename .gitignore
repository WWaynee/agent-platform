# 环境变量、密钥（最重要，防止API密钥上传）
.env
.env.*
!.env.example

# Go 编译产物
bin/
*.exe
*.out
*.test
# 根目录 go build 直接产物（临时编译，勿提交）。锚定根目录，避免误匹配 tools/fault_inject_llm 源码目录
/fault_inject_llm

# 日志文件
*.log
logs/

# IDE 缓存与配置
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 本地 AI 助手工具配置
.continue/

# Docker 本地持久化数据（容器挂载目录，不要提交）
data/

# 临时文件
tmp/
temp/
*.tmp